AUTH_SECRET=replace-with-a-long-random-string
# Public URL of the Node app (local or Vercel — not static GitHub Pages).
AUTH_URL=http://localhost:3000

# Google (https://console.cloud.google.com/apis/credentials)
# Local:  http://localhost:3000/api/auth/callback/google
# Vercel: https://YOUR_PROJECT.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# GitHub (https://github.com/settings/developers)
# Local:  http://localhost:3000/api/auth/callback/github
# Vercel: https://YOUR_PROJECT.vercel.app/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

ADMIN_EMAIL=admin@math12.local
ADMIN_PASSWORD=changeme

# Recommended on Vercel so user data survives cold starts (Atlas free tier OK)
# MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=math12

# GitHub Pages bridge variable LIVE_APP_URL → https://YOUR_PROJECT.vercel.app

# Optional AI for Notebook chat / richer Studio outputs
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
