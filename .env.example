AUTH_SECRET=replace-with-a-long-random-string
# Must match where the Node app actually runs (not static GitHub Pages).
AUTH_URL=http://localhost:3000

# Google (https://console.cloud.google.com/apis/credentials)
# Also add local redirect: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# GitHub (https://github.com/settings/developers)
# Also add local callback: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

ADMIN_EMAIL=admin@math12.local
ADMIN_PASSWORD=changeme
