AUTH_SECRET=replace-with-a-long-random-string
# Public URL of the Node app (local or Heroku — not static GitHub Pages).
AUTH_URL=http://localhost:3000

# Google (https://console.cloud.google.com/apis/credentials)
# Local:  http://localhost:3000/api/auth/callback/google
# Heroku: https://YOUR_APP.herokuapp.com/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# GitHub (https://github.com/settings/developers)
# Local:  http://localhost:3000/api/auth/callback/github
# Heroku: https://YOUR_APP.herokuapp.com/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

ADMIN_EMAIL=admin@math12.local
ADMIN_PASSWORD=changeme

# MongoDB Atlas (GitHub Student Developer Pack — $50 credits)
# MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=math12

# GitHub Pages bridge variable LIVE_APP_URL → https://YOUR_APP.herokuapp.com



