AUTH_SECRET=replace-with-a-long-random-string
# Must match where the Node app actually runs (local or Vercel — not static GitHub Pages).
AUTH_URL=http://localhost:3000

# Google (https://console.cloud.google.com/apis/credentials)
# Local:  http://localhost:3000/api/auth/callback/google
# Vercel: https://YOUR_PROJECT.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# GitHub (https://github.com/settings/developers)
# Local:  http://localhost:3000/api/auth/callback/github
# Vercel: https://YOUR_PROJECT.vercel.app/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

ADMIN_EMAIL=admin@math12.local
ADMIN_PASSWORD=changeme

# GitHub Pages bridge (repo Actions variable LIVE_APP_URL) should point at the Vercel URL:
# LIVE_APP_URL=https://YOUR_PROJECT.vercel.app


# Optional AI for Notebook chat / richer Studio outputs
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

